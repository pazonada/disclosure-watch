# Supabase (for subscribers + digests — set up at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (for email — set up at resend.com)
RESEND_API_KEY=re_your_api_key
RESEND_AUDIENCE_ID=your-audience-id

# Admin dashboard (simple password auth)
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=a-random-uuid-or-long-string

# Ingestion + cron auth
INGEST_SECRET=your-ingest-bearer-token

# Site
NEXT_PUBLIC_SITE_URL=https://disclosurewatch.com
