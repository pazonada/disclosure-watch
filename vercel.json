{
  "framework": "nextjs",
  "functions": {
    "app/api/ingest/route.ts": {
      "maxDuration": 120
    },
    "app/api/health-check/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/admin/digests/auto-send",
      "schedule": "15 17 * * 5"
    },
    {
      "path": "/api/admin/digests/auto-send",
      "schedule": "15 17 * * 6"
    },
    {
      "path": "/api/admin/digests/auto-send",
      "schedule": "15 17 * * 0"
    },
    {
      "path": "/api/alerts/daily-digest",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/health-check",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/admin/email-monitor",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/admin/content-monitor",
      "schedule": "30 14 * * *"
    }
  ]
}
